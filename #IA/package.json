{
  "name": "crm-alunos",
  "version": "0.1.0",
  "private": true,
  "description": "CRM interno para gestão dos alunos dos cursos",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:api": "dotenv -e .env.local -- tsx watch server/server.ts",
    "start:api": "tsx server/server.ts",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "dotenv -e .env.test -- jest -c jest.integration.config.js --runInBand",
    "e2e": "dotenv -e .env.test -- playwright test",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:validate": "dotenv -e .env.local -- prisma validate",
    "db:seed-admin": "dotenv -e .env.local -- tsx server/database/seeds/seedAdmin.ts",
    "rag:embed": "tsx .claude/scripts/embed.ts",
    "rag:search": "tsx .claude/scripts/search.ts",
    "rag:reindex": "tsx .claude/scripts/embed.ts --todos",
    "db:seed-demo": "dotenv -e .env.local -- tsx server/database/seeds/seedDemo.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "next": "^15.5.25",
    "nodemailer": "^7.0.13",
    "pino": "^9.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@xenova/transformers": "^2.17.2",
    "autoprefixer": "^10.5.6",
    "better-sqlite3": "^13.0.3",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "sqlite-vec": "^0.1.9",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
