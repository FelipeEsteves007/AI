# Copie para .env.local e preencha. Nunca commite o .env.local.
NODE_ENV=development

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/crm_alunos?schema=public"

# Autenticação (JWT HS256, expira em 24h, enviado em cookie HttpOnly)
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=

# API Express
API_PORT=3001
API_URL=http://localhost:3001

# Primeiro admin (script npm run db:seed-admin)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@exemplo.local

# Logs da API (Pino): trace, debug, info, warn, error, fatal ou silent
LOG_LEVEL=info

# E-mail (nodemailer / SMTP). Sem SMTP_HOST, o envio é simulado (nada sai da máquina).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
